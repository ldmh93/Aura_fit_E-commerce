# ─────────────────────────────────────────────────────────────
# AURA FIT — Variables de entorno
# Copiar a .env.local y rellenar. NUNCA commitear .env.local
# La app funciona sin estas variables usando datos mock.
# ─────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Jamás con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Contacto / checkout
# Formato internacional sin + ni espacios. Ej. México: 5215512345678
NEXT_PUBLIC_WHATSAPP_NUMBER=5215500000000

# Sitio
NEXT_PUBLIC_SITE_URL=https://aurafit.com

# Analítica
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
